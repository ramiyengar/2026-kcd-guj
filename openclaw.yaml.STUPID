apiVersion: openclaw.rocks/v1alpha1
kind: OpenClawInstance
metadata:
  name: local-agent
  namespace: openclaw
spec:
  env:
    - name: OLLAMA_BASE_URL
      value: "http://ollama-service.openclaw.svc.cluster.local:11434"
    - name: MODEL_NAME
      value: "llama3"
    - name: OPENCLAW_GATEWAY_HTTP_ENDPOINTS_CHATCOMPLETIONS
      value: '{"enabled": true}'
