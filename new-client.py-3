import asyncio
import httpx
from mcp import ClientSession
from mcp.client.sse import sse_client

async def main():
    server_url = "http://localhost:8081/sse" 
    print(f"Connecting to OpenCost MCP server at {server_url}...")

    custom_headers = {
        "User-Agent": "MCP-Python-Client/1.0",
        "Origin": "http://localhost:8081"
    }

    try:
        async with sse_client(url=server_url, headers=custom_headers) as streams:
            async with ClientSession(*streams) as session:
                await session.initialize()
                print("Session initialized successfully!\n")
                
                print("Executing tool: get_allocation_costs")
                cost_result = await session.call_tool(
                    "get_allocation_costs", 
                    {"window": "7d", "aggregate": "namespace"}
                )
                
                print("\nCost Result:")
                for content in cost_result.content:
                    print(content.text)

    # Unpack ExceptionGroups (from asyncio.TaskGroup)
    except ExceptionGroup as eg:
        for exc in eg.exceptions:
            if isinstance(exc, httpx.HTTPStatusError):
                print(f"\n[UNPACKED] HTTP Error: {exc.response.status_code}")
                print(f"[UNPACKED] Server Response Body: {exc.response.text}")
            else:
                print(f"Sub-exception: {exc}")
                
    # Fallback for standard synchronous errors
    except httpx.HTTPStatusError as e:
        print(f"\nHTTP Error: {e.response.status_code}")
        print(f"Server Response Body: {e.response.text}")
    except Exception as e:
        print(f"Failed to connect or execute: {e}")

if __name__ == "__main__":
    asyncio.run(main())
